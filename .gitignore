# Python
pipeline/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Env / secrets
.env
web/.env
*.local
# 雪球浏览器 cookie（会话 token，绝不入库）
.xueqiu_cookie*
.xueqiu_storage_state*
# Apple Sign in 私钥（绝不入库）
*.p8
AuthKey_*.p8

# Data / DB（本地真源不进 Git；pipeline/data 字典样本照常入库）
data/*.db
# data/dev.db 是 Prismo 本地内容真源；仓库只提交 make snapshot-db 生成的压缩部署快照。
data/*.db-wal
data/*.db-shm
data/sec_company_tickers.json
# dev.db 的备份/快照（make backup-db 产物：*.db.kolbak / *.db.bak-* / *.db.wiped*）——体积大、可再生，绝不入库
data/*.db.*
!data/dev.db.xz
!data/dev.db.xz.part-*
!data/dev.db.xz.parts
!data/dev.db.snapshot.json
data/.snapshot-*/
# YouTube 完整内容管线的临时视频/帧下载（截完即删，偶有残留），体积大不入库
data/_ytframes_tmp/
# 实验/管线中间产物导出（可由 make 重新生成，体积大，不入库）
data/exports/
# Private Smart Voice raw channel databases and generated reports are local,
# reproducible analysis artifacts and may contain large source payloads.
data/private_sv/
data/reports/private_smart_voice/
*.sqlite3

