BSMART_ENV=development
X_INGEST_ENABLED=false
BSMART_X_DATABASE_URL=sqlite:///./data/x_realtime.db
BSMART_READ_MODEL_DATABASE_URL=sqlite:///./data/client_api.db
BSMART_CLIENT_API_DATABASE_URL=sqlite:///./data/client_api.db
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io
TWITTERAPI_IO_STREAM_URL=wss://ws.twitterapi.io/twitter/tweet/websocket
BSMART_X_WEBHOOK_TOKEN=
# Use the outbound WebSocket transport for a fully local deployment.
BSMART_X_STREAM_ENABLED=false
BSMART_X_STREAM_RECONNECT_SECONDS=90
BSMART_X_TICKERS=AVGO,HOOD,MSTR,MU,NVDA,PLTR
BSMART_X_PRIORITY_TICKERS=
# Set to 10 for the first 24-hour canary; set to 0 for the full top quartile.
BSMART_X_POOL_LIMIT=10
BSMART_X_PROCESS_BATCH_SIZE=25
BSMART_X_PROCESS_WORKERS=4
BSMART_X_PROCESS_INTERVAL_SECONDS=10
BSMART_X_RECONCILE_INTERVAL_SECONDS=900
BSMART_X_PUBLISH_INTERVAL_SECONDS=60
BSMART_X_RULE_INTERVAL_SECONDS=60
BSMART_X_RECONCILE_MAX_PAGES=40
BSMART_X_MONTHLY_COST_LIMIT_USD=100
# Update this estimate when the production extraction/translation model changes.
BSMART_X_ESTIMATED_MODEL_COST_PER_POST_USD=0.0003
