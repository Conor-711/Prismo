{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "services/client_api/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m services.client_api.content_release.push --watch",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
