PUBLIC_HOST=api.example.com
POSTGRES_DB=prismo
POSTGRES_USER=prismo
POSTGRES_PASSWORD=replace-with-a-random-url-safe-secret
POSTGRES_BIND_PORT=54329
DATABASE_URL=postgresql://prismo:replace-with-a-random-url-safe-secret@postgres:5432/prismo

BSMART_ENV=production
BSMART_READ_MODEL_MODE=database
X_INGEST_ENABLED=false
TWITTERAPI_IO_KEY=
BSMART_X_WEBHOOK_TOKEN=
BSMART_X_STREAM_ENABLED=true
BSMART_X_STREAM_RECONNECT_SECONDS=90
BSMART_X_TICKERS=AVGO,HOOD,MSTR,MU,NVDA,PLTR
BSMART_X_PRIORITY_TICKERS=
BSMART_X_POOL_LIMIT=0
BSMART_X_PROCESS_BATCH_SIZE=20
BSMART_X_PROCESS_WORKERS=2
BSMART_X_PROCESS_INTERVAL_SECONDS=10
BSMART_X_RECONCILE_INTERVAL_SECONDS=900
BSMART_X_PUBLISH_INTERVAL_SECONDS=60
BSMART_X_RULE_INTERVAL_SECONDS=60
BSMART_X_RECONCILE_MAX_PAGES=40
BSMART_X_MONTHLY_COST_LIMIT_USD=100
BSMART_X_ESTIMATED_MODEL_COST_PER_POST_USD=0.0003

SV_EXTRACT_PROVIDERS=qwen,deepseek,gemini
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_MODEL_LOW=qwen-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_LOW=deepseek-v4-flash
DEEPSEEK_MODEL_MID=deepseek-v4-pro
BSMART_MR_COLLIE_MODEL=deepseek-v4-flash
BSMART_MR_COLLIE_TIMEOUT_SECONDS=45
BSMART_MR_COLLIE_REQUESTS_PER_MINUTE=8
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
