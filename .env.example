# ============================================================
#  Reddit 版 Kaito Pro — 环境变量样例
#  复制为 .env 并填入真实值：  cp .env.example .env
# ============================================================

# ---- Reddit Data API ----------------------------------------
# 在 https://www.reddit.com/prefs/apps 创建一个 "script" 类型 app。
# 注意：2025-11 起 Reddit Responsible Builder Policy 要求 app 预先申请审批
#       （含个人/非商用项目）。请确认你的 app 已获批。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# User-Agent 必须唯一且含联系人用户名，例如：
REDDIT_USER_AGENT=reddit-kaito-pro/0.1 (by u/your_reddit_username)

# ---- Anthropic (Claude) -------------------------------------
ANTHROPIC_API_KEY=
# 模型（可改）：高并发打标用 Haiku，综合/叙事用 Sonnet，简报可用 Opus
ANTHROPIC_MODEL_TAG=claude-haiku-4-5
ANTHROPIC_MODEL_SYNTH=claude-sonnet-4-6
ANTHROPIC_MODEL_BRIEF=claude-sonnet-4-6

# ---- Mr Collie / DeepSeek ------------------------------------
# The iOS app never receives this key. The authenticated Client API uses it to
# generate evidence-grounded answers and validates returned evidence IDs.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_LOW=deepseek-v4-flash
DEEPSEEK_MODEL_MID=deepseek-v4-pro
BSMART_MR_COLLIE_MODEL=deepseek-v4-flash
BSMART_MR_COLLIE_TIMEOUT_SECONDS=45
BSMART_MR_COLLIE_REQUESTS_PER_MINUTE=8

# ---- Database (SQLAlchemy URL，Python 管线用) ----------------
# 本地开发默认 SQLite（零配置）：
DATABASE_URL=sqlite:///./data/dev.db
#
# 云端（Supabase = Postgres，推荐：数据真正存在云端、可持久化、避免重复分析）：
# 从 Supabase → Project Settings → Database → Connection string → URI 复制（含密码），形如：
#   DATABASE_URL=postgresql://postgres.xxxx:[你的密码]@aws-0-xxx.pooler.supabase.com:6543/postgres
# 粘贴成上面这种 postgres 串后，整条管线就写入云端（会自动转 psycopg + 强制 SSL，无需手改）。
# 一次性迁移与日常构建步骤见 CLOUD_DB.md（make cloud-init / make site-cloud）。

# ---- 管线参数（可选，留空用默认） ---------------------------
INGEST_POST_LIMIT=120          # 每板块每来源拉取条数
INGEST_COMMENT_MIN_SCORE=15    # 顶层评论入库的最低分（控量）
MINDSHARE_WINDOW_HOURS=24      # 默认 mindshare 窗口
# X Smart Account realtime ingestion (disabled by default)
X_INGEST_ENABLED=false
TWITTERAPI_IO_KEY=
BSMART_X_WEBHOOK_TOKEN=
BSMART_X_STREAM_ENABLED=false
TWITTERAPI_IO_STREAM_URL=wss://ws.twitterapi.io/twitter/tweet/websocket
# Production may set only DATABASE_URL; all three stores then share that PostgreSQL database.
# The explicit URLs below are optional overrides for split-database deployments.
BSMART_X_DATABASE_URL=sqlite:///./data/x_realtime.db
BSMART_READ_MODEL_DATABASE_URL=sqlite:///./data/client_api.db
BSMART_CLIENT_API_DATABASE_URL=sqlite:///./data/client_api.db
BSMART_X_TICKERS=AVGO,HOOD,MSTR,MU,NVDA,PLTR
BSMART_X_POOL_LIMIT=10
BSMART_X_PROCESS_WORKERS=4
BSMART_X_RECONCILE_INTERVAL_SECONDS=900
BSMART_X_MONTHLY_COST_LIMIT_USD=100
BSMART_X_ESTIMATED_MODEL_COST_PER_POST_USD=0.0003
# APNs delivery worker (the private key may be a mounted file or a PEM secret)
BSMART_APNS_TEAM_ID=
BSMART_APNS_KEY_ID=
BSMART_APNS_TOPIC=today.bsmart.ios
BSMART_APNS_PRIVATE_KEY_PATH=
BSMART_APNS_PRIVATE_KEY=
BSMART_NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
BSMART_NOTIFICATION_DISPATCH_LIMIT=100
# Hyperdash is the primary Smart Money source. Hyperliquid remains an explicit fallback mode.
BSMART_SMART_MONEY_ENABLED=false
BSMART_SMART_MONEY_PRIMARY_SOURCE=hyperdash
BSMART_SMART_MONEY_LOOKBACK_DAYS=30
BSMART_SMART_MONEY_REFRESH_SECONDS=600
BSMART_HYPERDASH_GRAPHQL_URL=https://api.hyperdash.com/graphql
BSMART_HYPERDASH_GROUP_ID=equities
BSMART_HYPERDASH_MAX_WALLETS=100
BSMART_HYPERDASH_POSITION_LIMIT=12
BSMART_HYPERDASH_MAX_STALE_SECONDS=1800
# Optional: combine the current real Smart Account updates with each Hyperdash
# snapshot when generating iOS portfolio signals.
BSMART_SMART_ACCOUNT_UPDATES_PATH=
# Optional approved Hyperdash API/session credentials.
BSMART_HYPERDASH_AUTHORIZATION=
BSMART_HYPERDASH_COOKIE=
